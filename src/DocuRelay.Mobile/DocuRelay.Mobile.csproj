<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>DocuRelay.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>DocuRelay Field</ApplicationTitle>
    <ApplicationId>com.philippegodfroy.docurelayfield</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- API 34 is installed locally; CI can use the workload's current SDK. -->
    <AndroidTargetSdkVersion Condition="'$(CI)' != 'true'">34</AndroidTargetSdkVersion>
    <AndroidCompileSdkVersion Condition="'$(CI)' != 'true'">34</AndroidCompileSdkVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#087E8B" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#087E8B" BaseSize="128,128" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <ProjectReference Include="../DocuRelay.Contracts/DocuRelay.Contracts.csproj" />
  </ItemGroup>
</Project>
